{
  "name": "vib-sdk",
  "version": "0.1.0",
  "description": "Query and update a vib blob-native vector index (slabs in R2 or any S3-compatible store) from Cloudflare Workers",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./wasm/vib_bg.wasm": {
      "types": "./dist/wasm/module.d.ts",
      "default": "./dist/wasm/vib_bg.wasm"
    },
    "./wasm": {
      "types": "./dist/wasm/module.d.ts",
      "default": "./dist/wasm/vib_bg.wasm"
    },
    "./wasm/vib.js": {
      "types": "./dist/wasm/vib.d.ts",
      "default": "./dist/wasm/vib.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "vector-search",
    "cloudflare-workers",
    "r2",
    "s3",
    "wasm",
    "ann"
  ],
  "scripts": {
    "sync-wasm": "scripts/sync-wasm.sh",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && mkdir -p dist/wasm && cp src/wasm/vib.js src/wasm/vib.d.ts src/wasm/vib_bg.wasm src/wasm/vib_bg.wasm.d.ts src/wasm/module.d.ts dist/wasm/",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "beta",
    "@cloudflare/workers-types": "^5.20261003.1",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.0.0"
  },
  "license": "MIT"
}
