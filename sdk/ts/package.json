{
  "name": "@aiuitech/thread-sdk",
  "version": "0.2.2",
  "description": "Query and update a thread blob-native search index (slabs and segments in R2, any S3-compatible store, a directory or a single pack file) from Cloudflare Workers and Node",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiuitech/thread.git",
    "directory": "sdk/ts"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./wasm/thread_bg.wasm": {
      "types": "./dist/wasm/module.d.ts",
      "default": "./dist/wasm/thread_bg.wasm"
    },
    "./wasm": {
      "types": "./dist/wasm/module.d.ts",
      "default": "./dist/wasm/thread_bg.wasm"
    },
    "./wasm/thread.js": {
      "types": "./dist/wasm/thread.d.ts",
      "default": "./dist/wasm/thread.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "vector-search",
    "cloudflare-workers",
    "r2",
    "s3",
    "wasm",
    "ann"
  ],
  "scripts": {
    "sync-wasm": "scripts/sync-wasm.sh",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && mkdir -p dist/wasm && cp src/wasm/thread.js src/wasm/thread.d.ts src/wasm/thread_bg.wasm src/wasm/thread_bg.wasm.d.ts src/wasm/module.d.ts dist/wasm/",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "beta",
    "@cloudflare/workers-types": "^5.20261003.1",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.0.0"
  },
  "license": "MIT"
}
