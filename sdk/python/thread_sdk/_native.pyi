"""Type stubs for the native extension (crates/thread-py): thread-core's kernels, without I/O."""

from collections.abc import Sequence

from typing_extensions import Buffer
from typing import Any, Literal

__version__: str

FloatsLike = Buffer | Sequence[float]
IdsLike = Buffer | Sequence[int]

class MissingRanges(Exception):
    ranges: list[tuple[int, int]]

class IndexFormatError(ValueError): ...
class IndexCorruptError(ValueError): ...
class IndexStateError(RuntimeError): ...

class PqCodebook:
    def __init__(self, codebook: Buffer) -> None: ...
    @property
    def dim(self) -> int: ...
    @property
    def m(self) -> int: ...

class Query:
    @property
    def dim(self) -> int: ...
    @property
    def has_dots(self) -> bool: ...
    @property
    def has_table(self) -> bool: ...
    def vector(self) -> list[float]: ...

class Searcher:
    def __init__(self, dim: int, k1: int, k2: int, coarse_means: FloatsLike, fine_means: FloatsLike) -> None: ...
    @staticmethod
    def from_table(dim: int, k1: int, k2: int, coarse_means: FloatsLike, table: Buffer, elem: str) -> Searcher: ...
    @property
    def dim(self) -> int: ...
    @property
    def cells(self) -> int: ...
    def query(self, q: FloatsLike, dots: bool = False, codebook: PqCodebook | None = None) -> Query: ...
    def route(self, query: Query, probe_coarse: int, nprobe: int) -> list[int]: ...

class ColdRouter:
    def __init__(self, tree: Buffer, elem: str) -> None: ...
    @property
    def dim(self) -> int: ...
    @property
    def k(self) -> int: ...
    @property
    def groups(self) -> int: ...
    @property
    def row_bytes(self) -> int: ...
    @property
    def loaded_cells(self) -> int: ...
    @property
    def loaded_groups(self) -> int: ...
    def group_rows(self, g: int) -> tuple[int, int]: ...
    def cell_row(self, c: int) -> int | None: ...
    def missing_cells(self, cells: IdsLike) -> list[int]: ...
    def missing_groups(self, query: Query, beam: int) -> list[int]: ...
    def add_rows(self, first_row: int, rows: Buffer) -> int: ...
    def query(self, q: FloatsLike, dot_cells: IdsLike | None = None, codebook: PqCodebook | None = None) -> Query: ...
    def route_beam(self, query: Query, beam: int, nprobe: int) -> list[int]: ...

def routing_table_encode(means: FloatsLike, dim: int, elem: str) -> bytes: ...
